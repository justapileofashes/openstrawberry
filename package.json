{
  "name": "openstrawberry",
  "productName": "OpenStrawberry",
  "desktopName": "openstrawberry",
  "version": "0.1.0",
  "description": "A local-first agentic desktop browser.",
  "openstrawberryUpdateChannel": {
    "provider": "github",
    "owner": "justapileofashes",
    "repo": "openstrawberry",
    "enabled": false
  },
  "author": {
    "name": "OpenStrawberry contributors",
    "email": "opensource@openstrawberry.dev"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "icon": "electron scripts/render-icon.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "check": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run --config vitest.config.ts",
    "build": "vite build && tsc -p tsconfig.main.json",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "io.openstrawberry.browser",
    "productName": "OpenStrawberry",
    "artifactName": "OpenStrawberry-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "justapileofashes",
        "repo": "openstrawberry",
        "releaseType": "release"
      }
    ],
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "OpenStrawberry-mac-universal.${ext}",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "OpenStrawberry-win-x64.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenStrawberry",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "artifactName": "OpenStrawberry-linux-${arch}.${ext}",
      "icon": "resources/linux-icons",
      "synopsis": "A local-first agentic desktop browser",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network"
    },
    "rpm": {
      "compression": "xz"
    }
  }
}
