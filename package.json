{
  "name": "openstrawberry",
  "productName": "OpenStrawberry",
  "desktopName": "openstrawberry",
  "version": "0.1.0",
  "description": "A local-first agentic desktop browser.",
  "openstrawberryUpdateChannel": {
    "provider": "github",
    "owner": "justapileofashes",
    "repo": "openstrawberry",
    "enabled": false
  },
  "author": {
    "name": "OpenStrawberry contributors",
    "email": "opensource@openstrawberry.dev"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "icon": "electron scripts/render-icon.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "check": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run --config vitest.config.ts",
    "build": "vite build && tsc -p tsconfig.main.json",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir",
    "checksums": "node scripts/checksums.mjs",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release": "pnpm verify:config && pnpm release:preflight && pnpm check && pnpm test && pnpm build && electron-builder --publish never --config.mac.notarize=true && pnpm checksums && pnpm verify:artifacts"
  },
  "comment:dependencies": "Empty on purpose. electron-builder ships every production dependency inside the asar, and nothing here is loaded at runtime: React, React DOM, and Lucide are bundled into the renderer by Vite, and electron-updater is not imported at all until a transport is wired. Declaring them as runtime dependencies shipped sixteen packages and fifty source maps of never-executed code in every artifact. They move back the moment something actually requires them at runtime.",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.2.0",
    "electron-updater": "6.8.9",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "io.openstrawberry.browser",
    "productName": "OpenStrawberry",
    "artifactName": "OpenStrawberry-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "justapileofashes",
        "repo": "openstrawberry",
        "releaseType": "release"
      }
    ],
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "OpenStrawberry-mac-universal.${ext}",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "OpenStrawberry-win-x64.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenStrawberry",
      "uninstallDisplayName": "OpenStrawberry",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "artifactName": "OpenStrawberry-linux-${arch}.${ext}",
      "icon": "resources/linux-icons",
      "executableName": "openstrawberry",
      "synopsis": "A local-first agentic desktop browser",
      "description": "A local-first, open-source desktop browser with browser-native AI companions, review-first agent orchestration, and privacy-aware migration.",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "desktop": {
        "entry": {
          "Name": "OpenStrawberry",
          "GenericName": "Web Browser",
          "Comment": "A local-first agentic desktop browser",
          "Categories": "Network;WebBrowser;",
          "Keywords": "browser;web;internet;chromium;agent;companion;openstrawberry;",
          "StartupNotify": "true",
          "StartupWMClass": "openstrawberry",
          "Terminal": "false",
          "Type": "Application"
        }
      }
    },
    "rpm": {
      "compression": "xz"
    }
  }
}
